{
  "name": "@local/dsh-startup-skip",
  "version": "0.1.0",
  "private": true,
  "description": "Conservative one-shot Desktop startup welcome compatibility shim; never stores API keys.",
  "type": "module",
  "license": "MIT",
  "author": "zerofancy",
  "repository": { "type": "git", "url": "git+https://github.com/zerofancy/dsh-startup-skip.git" },
  "homepage": "https://github.com/zerofancy/dsh-startup-skip#readme",
  "bugs": { "url": "https://github.com/zerofancy/dsh-startup-skip/issues" },
  "keywords": ["deepseek-harness", "dsh", "plugin", "desktop", "startup"],
  "engines": { "dsh": "0.2.1-rc.2" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "compatibility.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.en.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "test": "node --test --test-isolation=none test/*.test.js" }
}
